/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for private data and allows public read access to shared data.
 *
 * Data Structure:
 * All user-specific data is nested under `/users/{userId}`. This includes investment portfolios, expenses, financial goals, and news preferences.
 * Publicly accessible data, like stock information and news articles, are stored in top-level collections (`/stocks`, `/newsArticles`).
 *
 * Key Security Decisions:
 * - User data is strictly segregated and accessible only to the owning user.
 * - Public data is readable by all, but write access is heavily restricted (currently disabled).
 * - No user listing is allowed (to prevent enumeration).
 * - Data consistency is enforced by validating the `userId` field on creation.
 *
 * Denormalization for Authorization:
 * The `userId` is present on all user-owned documents to allow for efficient ownership checks without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces document ownership for User profiles.
     * @path /users/{userId}
     * @allow (create) - User with ID 'user123' can create their profile.
     *  Request: auth.uid == 'user123', resource.data.id == 'user123'
     * @allow (get, update, delete) - User with ID 'user123' can get, update, and delete their profile.
     *  Request: auth.uid == 'user123'
     * @deny (create) - User with ID 'user456' cannot create a profile for 'user123'.
     *  Request: auth.uid == 'user456', resource.data.id == 'user123'
     * @deny (get, update, delete) - User with ID 'user456' cannot access 'user123' profile.
     *  Request: auth.uid == 'user456'
     * @principle Enforces document ownership and validates relational integrity.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces document ownership for InvestmentPortfolios.
     * @path /users/{userId}/investmentPortfolios/{investmentPortfolioId}
     * @allow (create) - User with ID 'user123' can create a portfolio.
     *  Request: auth.uid == 'user123', resource.data.userId == 'user123'
     * @allow (get, update, delete) - User with ID 'user123' can get, update, and delete their portfolio.
     *  Request: auth.uid == 'user123'
     * @deny (create) - User with ID 'user456' cannot create a portfolio for 'user123'.
     *  Request: auth.uid == 'user456', resource.data.userId == 'user123'
     * @deny (get, update, delete) - User with ID 'user456' cannot access 'user123' portfolio.
     *  Request: auth.uid == 'user456'
     * @principle Enforces document ownership and validates relational integrity.
     */
    match /users/{userId}/investmentPortfolios/{investmentPortfolioId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);

       /**
         * @description Enforces document ownership for PortfolioStocks.
         * @path /users/{userId}/investmentPortfolios/{investmentPortfolioId}/portfolioStocks/{portfolioStockId}
         * @allow (create) - User with ID 'user123' can create a portfolio stock within their portfolio.
         *  Request: auth.uid == 'user123'
         * @allow (get, update, delete) - User with ID 'user123' can get, update, and delete their portfolio stock within their portfolio.
         *  Request: auth.uid == 'user123'
         * @deny (create) - User with ID 'user456' cannot create a portfolio stock for 'user123' portfolio.
         *  Request: auth.uid == 'user456'
         * @deny (get, update, delete) - User with ID 'user456' cannot access 'user123' portfolio stock.
         *  Request: auth.uid == 'user456'
         * @principle Enforces document ownership.
         */
      match /portfolioStocks/{portfolioStockId} {
        function isOwner(userId) {
          return request.auth != null && request.auth.uid == userId;
        }

        function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
        }

        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }
    }

    /**
     * @description Allows public read access to stock data, but restricts write access.
     * @path /stocks/{stockId}
     * @allow (get, list) - Any user can read stock data.
     *  Request: No auth required.
     * @deny (create, update, delete) - No user can create, update, or delete stock data.
     *  Request: Any auth.
     * @principle Provides public read access with restricted write access.
     */
    match /stocks/{stockId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add admin validation if needed.
    }

    /**
     * @description Enforces document ownership for Expenses.
     * @path /users/{userId}/expenses/{expenseId}
     * @allow (create) - User with ID 'user123' can create an expense.
     *  Request: auth.uid == 'user123', resource.data.userId == 'user123'
     * @allow (get, update, delete) - User with ID 'user123' can get, update, and delete their expense.
     *  Request: auth.uid == 'user123'
     * @deny (create) - User with ID 'user456' cannot create an expense for 'user123'.
     *  Request: auth.uid == 'user456', resource.data.userId == 'user123'
     * @deny (get, update, delete) - User with ID 'user456' cannot access 'user123' expense.
     *  Request: auth.uid == 'user456'
     * @principle Enforces document ownership and validates relational integrity.
     */
    match /users/{userId}/expenses/{expenseId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces document ownership for FinancialGoals.
     * @path /users/{userId}/financialGoals/{financialGoalId}
     * @allow (create) - User with ID 'user123' can create a financial goal.
     *  Request: auth.uid == 'user123', resource.data.userId == 'user123'
     * @allow (get, update, delete) - User with ID 'user123' can get, update, and delete their financial goal.
     *  Request: auth.uid == 'user123'
     * @deny (create) - User with ID 'user456' cannot create a financial goal for 'user123'.
     *  Request: auth.uid == 'user456', resource.data.userId == 'user123'
     * @deny (get, update, delete) - User with ID 'user456' cannot access 'user123' financial goal.
     *  Request: auth.uid == 'user456'
     * @principle Enforces document ownership and validates relational integrity.
     */
    match /users/{userId}/financialGoals/{financialGoalId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to news articles, but restricts write access.
     * @path /newsArticles/{newsArticleId}
     * @allow (get, list) - Any user can read news articles.
     *  Request: No auth required.
     * @deny (create, update, delete) - No user can create, update, or delete news articles.
     *  Request: Any auth.
     * @principle Provides public read access with restricted write access.
     */
    match /newsArticles/{newsArticleId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add admin validation if needed.
    }

    /**
     * @description Enforces document ownership for UserNewsPreferences.
     * @path /users/{userId}/newsPreferences/{newsPreferenceId}
     * @allow (create) - User with ID 'user123' can create news preferences.
     *  Request: auth.uid == 'user123', resource.data.userId == 'user123'
     * @allow (get, update, delete) - User with ID 'user123' can get, update, and delete their news preferences.
     *  Request: auth.uid == 'user123'
     * @deny (create) - User with ID 'user456' cannot create news preferences for 'user123'.
     *  Request: auth.uid == 'user456', resource.data.userId == 'user123'
     * @deny (get, update, delete) - User with ID 'user456' cannot access 'user123' news preferences.
     *  Request: auth.uid == 'user456'
     * @principle Enforces document ownership and validates relational integrity.
     */
    match /users/{userId}/newsPreferences/{newsPreferenceId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}